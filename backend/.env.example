# Intel Physical AI Challenge - Junction 2026
# Unified Cloud, AI & Data Hub (Merged Member 3 + Member 4)

# Google Gemini 3.8 Flash Multimodal Floor Copilot
GEMINI_API_KEY=your_gemini_key_here

# Cloudinary Visual Audit Trail & Heatmap Overlay
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# NVIDIA Nemotron 3.5 Super VL (Verda B300 Endpoint)
NEMOTRON_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
NEMOTRON_MODEL=nemotron-3.5-super-vl
NEMOTRON_API_KEY=

# MariaDB 11.7+ / 11.8 LTS Native VECTOR(512) + WITH SYSTEM VERSIONING Store (pure-Python pymysql)
# Supports mysql:// and mariadb:// (local 127.0.0.1:3306 or hosted TLS DB)
MARIADB_URI=mysql://junction_dev:junction2026_local@127.0.0.1:3306/junction_ai

# Modal Serverless Escalation & Retraining Webhook (`modal deploy backend/modal_webhook.py`)
# Persists escalated manifests to modal.Volume (`junction-defect-archive`) + modal.Dict (`junction-escalation-state`)
MODAL_WEBHOOK_URL=http://localhost:8000/mock-modal

PORT=8000
HOST=0.0.0.0
